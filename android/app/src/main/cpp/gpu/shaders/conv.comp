    const float bias_14 = has_bias ? w[pc.b_off + c0 + 14u] : 0.0;
    const uint dst_14 = obase + (c0 + 14u) * ho * wo;
    if (ox < wo && oy < ho) a[dst_14] = acc00_14 + bias_14;
    if (ox + 1u < wo && oy < ho) a[dst_14 + 1u] = acc01_14 + bias_14;
    if (ox < wo && oy + 1u < ho) a[dst_14 + wo] = acc10_14 + bias_14;
    if (ox + 1u < wo && oy + 1u < ho) a[dst_14 + wo + 1u] = acc11_14 + bias_14;
  }
  if (c0 + 15u < co_total) {
    const float bias_15 = has_bias ? w[pc.b_off + c0 + 15u] : 0.0;
    const uint dst_15 = obase + (c0 + 15u) * ho * wo;
    if (ox < wo && oy < ho) a[dst_15] = acc00_15 + bias_15;
    if (ox + 1u < wo && oy < ho) a[dst_15 + 1u] = acc01_15 + bias_15;
    if (ox < wo && oy + 1u < ho) a[dst_15 + wo] = acc10_15 + bias_15;
    if (ox + 1u < wo && oy + 1u < ho) a[dst_15 + wo + 1u] = acc11_15 + bias_15;
  }
}
