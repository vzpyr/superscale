#version 450

#include "pc.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer Weights { float w[]; };
layout(std430, binding = 1) buffer Arena { float a[]; };

void main() {
  const uint x = gl_GlobalInvocationID.x;
  const uint y = gl_GlobalInvocationID.y;
  const uint c = gl_GlobalInvocationID.z;
  const uint b = pc.n3;
  const uint ho = pc.n1 * b;
  const uint wo = pc.n2 * b;
  if (c >= pc.n0 || y >= ho || x >= wo) {
    return;
  }
  const uint oc = pc.kind == 1u
      ? ((y % b) * b + (x % b)) * pc.n0 + c
      : c * b * b + (y % b) * b + (x % b);
  const uint src = oc * pc.n1 * pc.n2 + (y / b) * pc.n2 + (x / b);
  a[pc.out_off + c * ho * wo + y * wo + x] = a[pc.in_off + src];
}
